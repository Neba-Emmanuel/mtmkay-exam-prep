# Public development configuration only. Never place private keys in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Application credentials are managed in Vercel environment settings.
# The current browser Gemini integration must remain disabled without a deliberately public key.
NEXT_PUBLIC_GEMINI_API_KEY=
